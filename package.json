{
  "name": "agentic-web-inspector",
  "version": "1.0.0",
  "description": "Check an open agentic website against the Open Agentic Web MVP specification, in your own browser.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agentic-web-inspect": "tools/inspect.mjs"
  },
  "scripts": {
    "start": "node tools/serve.mjs . --port 8080",
    "test": "node --test \"tests/*.test.mjs\"",
    "inspect": "node tools/inspect.mjs"
  }
}
